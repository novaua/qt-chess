        <file>pics/white/p.png</file>
        <file>pics/white/q.png</file>
        <file>pics/white/r.png</file>
    </qresource>
    <qresource prefix="/app">
        <file>pics/chess_icon.svg</file>
        <file>pics/ChessBackground.jpg</file>
        <file>pics/rotate.png</file>
    </qresource>
</RCC>
